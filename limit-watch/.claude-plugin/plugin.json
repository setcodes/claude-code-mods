{
  "name": "limit-watch",
  "version": "0.1.0",
  "description": "Usage-limit bar above the prompt: 5-hour and weekly limits with time to reset, resume after the limit resets, and a stay-awake toggle on macOS",
  "author": {
    "name": "Egor Maximov",
    "email": "support@setcode.ru",
    "url": "https://github.com/setcodes"
  },
  "homepage": "https://github.com/setcodes/claude-code-mods/tree/main/limit-watch",
  "repository": "https://github.com/setcodes/claude-code-mods",
  "license": "MIT",
  "keywords": [
    "limits",
    "usage",
    "rate-limit",
    "resume",
    "mod"
  ],
  "types": "./types/index.d.ts",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Language / Язык",
      "description": "auto — по языку системы / follow the OS language",
      "default": "auto",
      "options": [
        "auto",
        "ru",
        "en",
        "es",
        "de",
        "fr",
        "pt",
        "zh",
        "ja",
        "uk"
      ]
    }
  }
}
